{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make test-fast)",
      "Bash(make test)",
      "Bash(make test-integration)",
      "Bash(make audit)",
      "Bash(make check)",
      "Bash(make eval)",
      "Bash(make format)",
      "Bash(uv run --locked pytest tests*)",
      "Bash(uv run --locked coverage report *)",
      "Bash(uv run --locked ruff check *)",
      "Bash(docker compose up *)",
      "Bash(docker compose ps)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git switch main)",
      "Bash(git pull --ff-only)",
      "Bash(git fetch --prune)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git switch -c *)",
      "Bash(git branch -d *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(*.env)",
      "Bash(*.env *)",
      "Bash(git diff *--no-index*)",
      "Bash(git diff *--output*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git branch -D *)",
      "Bash(git branch -f *)",
      "Bash(git branch * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(rm -rf *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *--visibility*)"
    ]
  }
}
